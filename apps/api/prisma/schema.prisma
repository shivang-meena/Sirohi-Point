generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  CUSTOMER
  BUSINESS
  VENDOR
  CONTRACTOR
  DISTRIBUTOR
  ADMIN
}

enum OrderStatus {
  CONFIRMED
  ACCEPTED
  PACKED
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum OrderApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BuyerSegment {
  B2C
  B2B
}

enum PaymentMethod {
  COD
  ONLINE
}

enum BookingStatus {
  REQUESTED
  MATCHED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceApprovalStatus {
  PENDING_ADMIN
  APPROVED
  REJECTED
}

enum TechnicianResponse {
  PENDING
  ACCEPTED
  REJECTED
}

enum ContractorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractorAvailability {
  AVAILABLE
  BUSY
  OFFLINE
}

enum BannerAudience {
  B2C
  B2B
  BOTH
}

enum RfqStatus {
  DRAFT
  OPEN
  QUOTED
  AWARDED
  CLOSED
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  name              String
  phone             String?            @unique
  customerLocation  String?
  email             String?            @unique
  passwordHash      String?
  active            Boolean            @default(true)
  role              PlatformRole       @default(CUSTOMER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orders            Order[]
  serviceBookings   ServiceBooking[]   @relation("CustomerBookings")
  addresses         CustomerAddress[]
  vendorProfile     Vendor?
  contractorProfile ContractorProfile?
  businessProfile   BusinessProfile?
  rfqs              Rfq[]
}

model BusinessProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  businessName    String
  businessType    String?
  gstin           String?  @unique
  billingAddress  String
  shippingAddress String?
  approvalStatus  String   @default("PENDING")
  verified        Boolean  @default(false)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vendor {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  storeName String
  gstin     String?   @unique
  verified  Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
  quotes    Quote[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ContractorProfile {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @unique @db.Uuid
  skills          String[]
  serviceRadiusKm Int              @default(15)
  rating          Float            @default(0)
  verified        Boolean          @default(false)
  serviceArea     String?
  latitude        Float?
  longitude       Float?
  experienceYears Int?
  bio             String?
  approvalStatus  ContractorApprovalStatus @default(PENDING)
  availability    ContractorAvailability   @default(OFFLINE)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  services        ContractorService[]
  bookings        ServiceBooking[]
  offers          ServiceOffer[]
}

model ContractorService {
  id                 String            @id @default(uuid()) @db.Uuid
  contractorId       String            @db.Uuid
  serviceType        String
  description        String?
  visitChargeInPaise Int               @default(0)
  priceFromInPaise   Int?
  priceToInPaise     Int?
  active             Boolean           @default(true)
  contractor         ContractorProfile @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([serviceType, active])
}

model Product {
  id                    String      @id
  vendorId              String?     @db.Uuid
  categoryId            String      @db.Uuid
  subcategoryId         String?     @db.Uuid
  name                  String
  slug                  String      @unique
  brand                 String
  description           String
  priceInPaise          Int
  b2cPriceInPaise       Int
  b2bPriceInPaise       Int?
  minimumB2BQuantity    Int         @default(1)
  allowB2BBackorder     Boolean     @default(false)
  specifications        Json?
  compareAtPriceInPaise Int?
  rating                Float       @default(0)
  reviewCount           Int         @default(0)
  badge                 String?
  tone                  String      @default("#58696A")
  serviceAvailable      Boolean     @default(false)
  imageUrl              String?     @db.Text
  active                Boolean     @default(true)
  vendor                Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category              Category    @relation(fields: [categoryId], references: [id])
  subcategory           Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  inventory             Inventory?
  orderItems            OrderItem[]
  banners               Banner[]
  serviceOffers         ServiceOffer[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([categoryId, active])
  @@index([subcategoryId, active])
  @@index([brand])
}

model Category {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  slug          String        @unique
  sortOrder     Int           @default(0)
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  slug       String    @unique
  categoryId String    @db.Uuid
  sortOrder  Int       @default(0)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
  @@index([categoryId, sortOrder])
}

model Banner {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  subtitle        String?
  badge           String?
  imageUrl        String?  @db.Text
  productId       String?
  ctaLabel        String?
  audience        BannerAudience @default(B2C)
  backgroundColor String   @default("#0B1F33")
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active, sortOrder])
}

model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique
  onHand    Int      @default(0)
  reserved  Int      @default(0)
  available Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model Order {
  id              String          @id @default(uuid()) @db.Uuid
  customerId      String          @db.Uuid
  status          OrderStatus     @default(CONFIRMED)
  approvalStatus  OrderApprovalStatus @default(PENDING)
  buyerSegment    BuyerSegment    @default(B2C)
  approvedById    String?         @db.Uuid
  approvedAt      DateTime?
  rejectionReason String?
  paymentMethod   PaymentMethod
  deliveryAddress String
  totalInPaise    Int
  itemCount       Int
  customer        User            @relation(fields: [customerId], references: [id])
  items           OrderItem[]
  booking         ServiceBooking?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @db.Uuid
  productId        String
  quantity         Int
  backorderedQuantity Int @default(0)
  unitPriceInPaise Int
  buyerSegment     BuyerSegment @default(B2C)
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model ServiceBooking {
  id           String             @id @default(uuid()) @db.Uuid
  customerId   String             @db.Uuid
  contractorId String?            @db.Uuid
  orderId      String?            @unique @db.Uuid
  serviceType  String
  address      String
  addressId    String?            @db.Uuid
  scheduledFor DateTime?
  status       BookingStatus      @default(REQUESTED)
  approvalStatus        ServiceApprovalStatus @default(PENDING_ADMIN)
  technicianResponse    TechnicianResponse @default(PENDING)
  customerLatitude      Float?
  customerLongitude     Float?
  requestedPriceInPaise Int?
  finalPriceInPaise     Int?
  approvedById          String? @db.Uuid
  approvedAt            DateTime?
  acceptedAt            DateTime?
  rejectionReason       String?
  notes                 String?
  offerId               String? @db.Uuid
  offerTitle            String?
  discountInPaise       Int @default(0)
  offer                 ServiceOffer? @relation(fields: [offerId], references: [id], onDelete: SetNull)
  customer     User               @relation("CustomerBookings", fields: [customerId], references: [id])
  savedAddress CustomerAddress?   @relation(fields: [addressId], references: [id], onDelete: SetNull)
  contractor   ContractorProfile? @relation(fields: [contractorId], references: [id])
  order        Order?             @relation(fields: [orderId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([contractorId, scheduledFor])
  @@index([status])
}

model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  label       String
  line1       String
  city        String
  state       String?
  postalCode  String?
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings    ServiceBooking[]

  @@index([userId, isDefault])
}

model ServiceOffer {
  id              String @id @default(uuid()) @db.Uuid
  title           String
  description     String @default("")
  discountInPaise Int
  serviceType     String?
  contractorId    String? @db.Uuid
  productId       String?
  active          Boolean @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  contractor      ContractorProfile? @relation(fields: [contractorId], references: [id])
  product         Product? @relation(fields: [productId], references: [id])
  bookings        ServiceBooking[]
}

model Rfq {
  id              String    @id @default(uuid()) @db.Uuid
  requesterId     String    @db.Uuid
  title           String
  requirements    Json
  deliveryAddress String
  status          RfqStatus @default(DRAFT)
  requester       User      @relation(fields: [requesterId], references: [id])
  quotes          Quote[]
  closesAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([requesterId, status])
}

model Quote {
  id            String   @id @default(uuid()) @db.Uuid
  rfqId         String   @db.Uuid
  vendorId      String   @db.Uuid
  amountInPaise Int
  leadTimeDays  Int
  notes         String?
  rfq           Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  createdAt     DateTime @default(now())

  @@unique([rfqId, vendorId])
}
